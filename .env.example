# 任意: 本番と別コンテナにしたい場合のみ上書き
NEXT_PUBLIC_GTM_ID=GTM-T3QS2259

# GA4 測定 ID（GTM 管理画面の Google タグで設定）: G-BS30YQY1N7

# --- 問い合わせフォーム (Airtable) ---
# Personal Access Token (scope: data.records:write / 対象Baseのみ)。サーバー専用。NEXT_PUBLIC_ は付けない
# 値は .env.local または Vercel Environment Variables に書く（このファイルにトークンを入れない）
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appROfZa17mQV0IIF
AIRTABLE_TABLE_NAME=問い合わせ
# 任意: 新規レコードの「ステータス」に入れる値(選択肢名と完全一致)。未設定なら送らない
# AIRTABLE_STATUS_NEW=新規

# 任意: Cloudflare Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# フォーム送信後の Slack Incoming Webhook（サーバー専用。NEXT_PUBLIC_ は付けない）
# 例: https://hooks.slack.com/services/...
SLACK_WEBHOOK_URL=
